apiVersion: v1
kind: ConfigMap
metadata:
  name: laravel-config
  namespace: pi-k3s
data:
  APP_NAME: "Pi Calculator"
  APP_ENV: "production"
  APP_DEBUG: "false"
  APP_URL: "http://your-vps-ip-or-domain"
  LOG_CHANNEL: "stderr"
  LOG_LEVEL: "info"

  # Application database (MariaDB in K3s)
  DB_CONNECTION: "mysql"
  DB_HOST: "mariadb"
  DB_PORT: "3306"
  DB_DATABASE: "pi_k3s"
  DB_USERNAME: "pi_k3s"

  # Shared infrastructure
  CACHE_STORE: "redis"
  SESSION_DRIVER: "redis"
  QUEUE_CONNECTION: "redis"
  REDIS_CLIENT: "phpredis"
  REDIS_HOST: "your-redis-host"
  REDIS_PORT: "6379"

  # Broadcasting
  BROADCAST_DRIVER: "log"
