apiVersion: v1
kind: Secret
metadata:
  name: laravel-secrets
  namespace: pi-k3s
type: Opaque
data:
  # Generate APP_KEY: php artisan key:generate --show
  # Then encode:     echo -n 'base64:YOUR_KEY_HERE' | base64
  APP_KEY: REPLACE_WITH_BASE64_ENCODED_APP_KEY

  # MariaDB credentials
  DB_PASSWORD: REPLACE_WITH_BASE64_ENCODED_DB_PASSWORD
  MARIADB_ROOT_PASSWORD: REPLACE_WITH_BASE64_ENCODED_MARIADB_ROOT_PASSWORD

  # Optional
  OPENAI_API_KEY: ""
